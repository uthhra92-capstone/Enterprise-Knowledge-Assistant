# TEMPLATE ONLY - do not put your real key here.
# Create your real config once:
#   Command Prompt:  copy .env.example .env
#   PowerShell:      Copy-Item .env.example .env
# ...then edit .env  (never .env.example).

# ---- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---- Models ------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional: point at Azure OpenAI / a compatible proxy
# OPENAI_BASE_URL=

# ---- Paths -------------------------------------------------------------
DATA_DIR=data/documents
STORAGE_DIR=storage

# ---- Vector store -------------------------------------------------------
VECTOR_BACKEND=faiss    # faiss | numpy  (numpy is a zero-dependency fallback)

# ---- Chunking --------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Retrieval ----------------------------------------------------------
TOP_K_VECTOR=8          # candidates from semantic search
TOP_K_BM25=8            # candidates from keyword (BM25) search
TOP_K_FUSED=10          # kept after reciprocal-rank fusion
TOP_K_FINAL=4           # passed to the LLM after reranking
RRF_K=60               # reciprocal-rank-fusion constant

# ---- Reranking --------------------------------------------------------
RERANKER=llm            # llm | cohere | none
COHERE_API_KEY=

# ---- Answering ---------------------------------------------------------
MEMORY_WINDOW=6         # chat turns kept as conversational context
SCORE_THRESHOLD=0.20    # min semantic similarity before the LLM may answer
TEMPERATURE=0.0
OPENAI_MAX_RETRIES=3
REQUEST_TIMEOUT=60

# Streamlit secrets - used when deploying to Streamlit Community Cloud.
#
# LOCAL DEV: you don't need this file; use a .env instead.
# DEPLOY:    paste the contents below into your app's
#            Settings -> Secrets box on share.streamlit.io
#            (do NOT commit a real key - secrets.toml is gitignored).
#
# Keys must be flat (no [sections]); the app copies them into environment
# variables that eka/config.py reads.

OPENAI_API_KEY = "sk-your-key-here"

# Optional overrides (defaults shown):
# LLM_MODEL = "gpt-4o-mini"
# EMBEDDING_MODEL = "text-embedding-3-small"
# VECTOR_BACKEND = "faiss"
# RERANKER = "llm"
# SCORE_THRESHOLD = "0.20"
